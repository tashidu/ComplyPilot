# ComplyPilot RefundShield - environment template
# Copy to .env.local and fill in. Never commit a populated .env file.

# --- Alibaba Cloud Model Studio (Qwen) ----------------------------------
# Create an API key in the Model Studio console, then copy it here.
DASHSCOPE_API_KEY=

# OpenAI-compatible endpoint. It differs by region - check your workspace.
#   Singapore / international : https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Beijing / mainland China  : https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Invoice extraction reads photographed documents, so this must be a
# vision-language model. Confirm the exact id available in your workspace.
QWEN_MODEL=qwen-vl-plus

# --- Workflow orchestration --------------------------------------------
# local  = deterministic in-process orchestrator (lib/workflows/orchestrator.ts)
# mulerun = MuleRun-hosted workflow (adapter not implemented yet)
WORKFLOW_MODE=local
MULERUN_API_URL=
MULERUN_API_KEY=
