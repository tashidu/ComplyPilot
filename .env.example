# ComplyPilot RefundShield - environment template
# Copy to .env.local and fill in. Never commit a populated .env file.

# Host port used by docker-compose.yml only.
APP_PORT=3000

# --- Database --------------------------------------------------------------
# Run state (extracted invoices, findings, reconciliation) lives in Postgres,
# not in process memory, so a case survives a container restart and one
# browser session can never read another's. There is no in-memory fallback.
#
# `docker compose up` starts its own Postgres container and wires this
# automatically - the value below is only needed for `npm run dev` against
# that same container from the host (it publishes on 5433, not Postgres's
# default 5432, so it never fights another project's Postgres for the port).
# POSTGRES_USER/PASSWORD/DB only take effect the first time the `db`
# container initialises its data volume.
DATABASE_URL=postgresql://complypilot:complypilot@localhost:5433/complypilot
POSTGRES_USER=complypilot
POSTGRES_PASSWORD=complypilot
POSTGRES_DB=complypilot
POSTGRES_PORT=5433

# --- Alibaba Cloud Model Studio (Qwen) ----------------------------------
# Create an API key in the Model Studio console, then copy it here.
DASHSCOPE_API_KEY=

# OpenAI-compatible endpoint. Copy the exact URL from the API Key page of the
# Model Studio console - each workspace has its own inference domain:
#   Singapore : https://<workspace-id>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#   Beijing   : https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# The shared endpoint below also answers, but prefer your workspace URL.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Invoice extraction reads photographed documents, so this must be a
# vision-language model. Confirm the exact id available in your workspace.
QWEN_MODEL=qwen-vl-plus

# Text model used by the grounded Data Copilot chatbox.
QWEN_CHAT_MODEL=qwen-plus

# Text model used only to explain the deterministic Refund Rescue plan.
QWEN_RESCUE_MODEL=qwen-plus

# Semantic supplier-name matching. The matcher always retains a transparent
# deterministic fallback and displays whether this model actually ran.
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# --- GUI filing agent ---------------------------------------------------
# The agent drives the bundled mock portal at /mock-portal with Playwright.
# Set to "false" to watch the browser on screen while recording the demo.
GUI_AGENT_HEADLESS=true

# Only needed if Chromium was installed outside the default location, e.g.
# PLAYWRIGHT_BROWSERS_PATH=D:\ms-playwright

# --- Workflow orchestration --------------------------------------------
# local   = deterministic in-process orchestrator only
# mulerun = post the extracted case to the MuleRun pre-flight workflow, and
#           fall back to the local orchestrator if it fails. The UI shows
#           "Workflow: LIVE MULERUN" or "Workflow: LOCAL FALLBACK" either way.
WORKFLOW_MODE=local

# Production webhook URL of your published MuleRun workflow. Copy it from the
# MuleRun workflow dashboard; there is no universal invoke URL to guess at.
MULERUN_API_URL=
# Sent as: Authorization: Bearer <key>
MULERUN_API_KEY=

# Conversational and explanatory tasks (copilot, rescue narrative).
# Vision and embeddings stay on Qwen. Blank = everything runs on Qwen.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
