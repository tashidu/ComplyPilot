# ComplyPilot RefundShield - environment template
# Copy to .env.local and fill in. Never commit a populated .env file.

# Host port used by docker-compose.yml only.
APP_PORT=3000

# --- Alibaba Cloud Model Studio (Qwen) ----------------------------------
# Create an API key in the Model Studio console, then copy it here.
DASHSCOPE_API_KEY=

# OpenAI-compatible endpoint. It differs by region - check your workspace.
#   Singapore / international : https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Beijing / mainland China  : https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Invoice extraction reads photographed documents, so this must be a
# vision-language model. Confirm the exact id available in your workspace.
QWEN_MODEL=qwen-vl-plus

# --- GUI filing agent ---------------------------------------------------
# The agent drives the bundled mock portal at /mock-portal with Playwright.
# Set to "false" to watch the browser on screen while recording the demo.
GUI_AGENT_HEADLESS=true

# Only needed if Chromium was installed outside the default location, e.g.
# PLAYWRIGHT_BROWSERS_PATH=D:\ms-playwright

# --- Workflow orchestration --------------------------------------------
# local   = deterministic in-process orchestrator only
# mulerun = post the extracted case to the MuleRun pre-flight workflow, and
#           fall back to the local orchestrator if it fails. The UI shows
#           "Workflow: LIVE MULERUN" or "Workflow: LOCAL FALLBACK" either way.
WORKFLOW_MODE=local

# Production webhook URL of your published MuleRun workflow. Copy it from the
# MuleRun workflow dashboard; there is no universal invoke URL to guess at.
MULERUN_API_URL=
# Sent as: Authorization: Bearer <key>
MULERUN_API_KEY=
