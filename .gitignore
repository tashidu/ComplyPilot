# Generated and temporary artifacts
tmp/
output/
frontend/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Local operating-system files
.DS_Store
Thumbs.db

# Editor and local environment files
.vscode/
.idea/
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.pyc

# IRD reference downloads. Kept locally for reference, never redistributed:
# the Schedule File Verifier is the Department's software, not ours, and a
# public repo is not the place for its binaries.
doc/

# Scratch output from exercising the auth endpoints. Holds a real user id,
# session token and password hash, so it must never reach the repo.
auth_temp.txt

# Office lock files. Present while a document is open, unreadable by git,
# and enough to make `git add -A` fail outright.
~$*
